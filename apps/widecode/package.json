{
  "name": "widecode",
  "private": true,
  "type": "module",
  "description": "The Claude Code frontend for wide terminals: chat, files and code side by side; a native core and JS plugins.",
  "dependencies": {
    "@lightstart/light": "workspace:*",
    "@light/highlight": "workspace:*",
    "@light/kernel": "workspace:*",
    "@light/lib": "workspace:*",
    "@light/markdown": "workspace:*",
    "@light/plugins": "workspace:*",
    "@light/ui": "workspace:*",
    "@light/workspace": "workspace:*",
    "@widecode/agent": "workspace:*",
    "@widecode/chat": "workspace:*",
    "@widecode/code": "workspace:*",
    "@widecode/conversation": "workspace:*",
    "@widecode/harness": "workspace:*",
    "@widecode/peers": "workspace:*",
    "@widecode/screen": "workspace:*"
  },
  "devDependencies": {
    "@light/test": "workspace:*",
    "@types/node": "^26.6.5"
  },
  "native": {
    "entry": "src/main.ts",
    "binary": "widecode",
    "ffi": "@light/plugins/native/ffi.json",
    "prepare": [
      "node --no-warnings scripts/builtin-plugins.mjs"
    ],
    "selftests": {
      "shell": {
        "checks": [
          [
            "started in the pty",
            "started 200x40"
          ],
          [
            "the build names its version and time",
            "^ *[0-9]* widecode .* built 20[0-9][0-9]-"
          ],
          [
            "tree: 4 files, 2 changed",
            "tree files=4 changed=2"
          ],
          [
            "code: the modified file, 2 changes",
            "code src/app.js hunks=2"
          ],
          [
            "a write came back as one batch",
            "changes src/app.js$"
          ],
          [
            "the code followed it: 3 changes",
            "code src/app.js hunks=3"
          ],
          [
            "within a second",
            "selftest change shown in [0-9]\\{1,3\\} ms"
          ],
          [
            "selftest ok",
            "selftest ok"
          ]
        ]
      },
      "fake": {
        "args": [
          "--claude",
          "test/fake-claude.mjs",
          "--fake-fixture",
          "test/fixtures/turn.ndjson"
        ],
        "checks": [
          [
            "started in the pty",
            "started 200x40"
          ],
          [
            "claude started",
            "claude started in"
          ],
          [
            "the turn ended with PONG on screen",
            "screen shows PONG: true"
          ],
          [
            "selftest ok",
            "selftest ok"
          ]
        ],
        "homeEnv": "WIDECODE_HOME",
        "home": {
          "config.json": {
            "plugins": {}
          }
        }
      },
      "fake-acp": {
        "homeEnv": "WIDECODE_HOME",
        "home": {
          "config.json": {
            "agent": "fake",
            "plugins": {
              "acp": {
                "agents": {
                  "fake": {
                    "name": "Fake",
                    "command": [
                      "node",
                      "test/fake-acp.mjs"
                    ]
                  }
                }
              }
            }
          }
        },
        "checks": [
          [
            "started in the pty",
            "started 200x40"
          ],
          [
            "the permission opened the panel",
            "selftest panel open: rm a.txt"
          ],
          [
            "allowed with a key: the call ran",
            "selftest allowed; the call said: removed"
          ],
          [
            "AskUser over widecode's MCP server opened the panel",
            "selftest panel open: AskUser"
          ],
          [
            "answered with a key: the agent got it",
            "selftest answered over MCP; the agent got Blue: true"
          ],
          [
            "selftest ok",
            "selftest ok"
          ]
        ]
      },
      "harness": {
        "homeEnv": "WIDECODE_HOME",
        "home": {
          "config.json": {
            "agent": "harness",
            "plugins": {
              "acp": {
                "agents": {
                  "harness": {
                    "name": "harness",
                    "command": [
                      "{widecode}",
                      "--harness",
                      "--harness-fake",
                      "test/fixtures/harness-model.jsonl"
                    ],
                    "tools": [
                      "{widecode}",
                      "--harness-tools",
                      "{mode}"
                    ],
                    "skills": [
                      "{widecode}",
                      "--harness-skills"
                    ],
                    "sessions": [
                      "{widecode}",
                      "--harness-sessions"
                    ],
                    "forget": [
                      "{widecode}",
                      "--harness-forget",
                      "{session}"
                    ],
                    "midTurn": true,
                    "own": true
                  }
                }
              }
            }
          }
        },
        "checks": [
          [
            "started in the pty",
            "started 200x40"
          ],
          [
            "the harness ran a command and replied",
            "selftest harness ran a command: true; screen shows PONG: true"
          ],
          [
            "AskUser over widecode's MCP server opened the panel",
            "selftest panel open: AskUser"
          ],
          [
            "answered with a key: the harness got it",
            "selftest answered over MCP; the harness got Blue: true"
          ],
          [
            "selftest ok",
            "selftest ok"
          ]
        ]
      },
      "live-turn": {
        "live": "claude",
        "args": [
          "--model",
          "haiku",
          "--effort",
          "low",
          "--ephemeral"
        ],
        "checks": [
          [
            "started in the pty",
            "started 200x40"
          ],
          [
            "claude started",
            "claude started in"
          ],
          [
            "the turn ended with PONG on screen",
            "screen shows PONG: true"
          ],
          [
            "selftest ok",
            "selftest ok"
          ]
        ]
      },
      "live-interrupt": {
        "live": "claude",
        "args": [
          "--model",
          "haiku",
          "--effort",
          "low",
          "--ephemeral"
        ],
        "checks": [
          [
            "Bash ran and was interrupted",
            "selftest Bash running; interrupting"
          ],
          [
            "the turn ended Interrupted",
            "interrupted notice: true"
          ],
          [
            "the next turn worked",
            "selftest second turn ended: success"
          ],
          [
            "selftest ok",
            "selftest ok"
          ]
        ]
      },
      "live-ask": {
        "live": "claude",
        "args": [
          "--model",
          "haiku",
          "--effort",
          "low",
          "--ephemeral"
        ],
        "checks": [
          [
            "the question opened the panel",
            "selftest panel open: AskUserQuestion"
          ],
          [
            "Claude got the answer",
            "Claude said: .*Blue"
          ],
          [
            "selftest ok",
            "selftest ok"
          ]
        ]
      },
      "live-plan": {
        "live": "claude",
        "args": [
          "--model",
          "haiku",
          "--effort",
          "low",
          "--ephemeral"
        ],
        "checks": [
          [
            "the plan opened the panel",
            "selftest panel open: ExitPlanMode"
          ],
          [
            "approved: bypass again, the file changed",
            "README has delta: true"
          ],
          [
            "selftest ok",
            "selftest ok"
          ]
        ]
      },
      "live-agent": {
        "live": "claude",
        "args": [
          "--model",
          "haiku",
          "--effort",
          "low",
          "--ephemeral"
        ],
        "checks": [
          [
            "the subagent's card holds its items",
            "the Agent card holds"
          ],
          [
            "selftest ok",
            "selftest ok"
          ]
        ]
      },
      "live-edit": {
        "live": "claude",
        "args": [
          "--model",
          "haiku",
          "--effort",
          "low",
          "--ephemeral"
        ],
        "checks": [
          [
            "the code column follows the new file, edited, untracked",
            "selftest code shows hello.txt \\[bye\\]; tree mark U"
          ],
          [
            "selftest ok",
            "selftest ok"
          ]
        ]
      },
      "live-quit": {
        "live": "claude",
        "args": [
          "--model",
          "haiku",
          "--effort",
          "low",
          "--ephemeral"
        ],
        "checks": [
          [
            "quit while Bash ran",
            "selftest Bash running; quitting"
          ]
        ],
        "noProcessLeft": "--no-session-persistence"
      },
      "live-acp": {
        "live": "opencode",
        "homeEnv": "WIDECODE_HOME",
        "home": {
          "config.json": {
            "agent": "opencode"
          }
        },
        "args": [
          "--model",
          "opencode/big-pickle"
        ],
        "checks": [
          [
            "started in the pty",
            "started 200x40"
          ],
          [
            "opencode ran a command and said PONG",
            "selftest opencode turn ended: end_turn; a command ran: true; screen shows PONG: true"
          ],
          [
            "selftest ok",
            "selftest ok"
          ]
        ]
      },
      "live-acp-ask": {
        "live": "opencode",
        "homeEnv": "WIDECODE_HOME",
        "home": {
          "config.json": {
            "agent": "opencode"
          }
        },
        "args": [
          "--model",
          "opencode/big-pickle"
        ],
        "checks": [
          [
            "widecode's AskUser opened the panel",
            "selftest panel open: AskUser"
          ],
          [
            "opencode got the answer",
            "selftest answered; opencode said: .*Blue"
          ],
          [
            "selftest ok",
            "selftest ok"
          ]
        ]
      },
      "live-acp-plan": {
        "live": "opencode",
        "homeEnv": "WIDECODE_HOME",
        "home": {
          "config.json": {
            "agent": "opencode"
          }
        },
        "args": [
          "--model",
          "opencode/big-pickle"
        ],
        "checks": [
          [
            "widecode's PresentPlan opened the panel",
            "selftest panel open: PresentPlan"
          ],
          [
            "approved: plan mode left, the file changed",
            "selftest plan approved; mode build; README has delta: true"
          ],
          [
            "selftest ok",
            "selftest ok"
          ]
        ]
      },
      "crash": {
        "wait": 20,
        "exitCode": 1,
        "checks": [
          [
            "started in the pty",
            "started 200x40"
          ],
          [
            "the error, as uncaught",
            "uncaught exception: RangeError: Maximum call stack size exceeded"
          ],
          [
            "the trail: what was open when it happened",
            "^open: selftest crash"
          ],
          [
            "the trail's frames",
            "^frames: [1-9]"
          ],
          [
            "where the run was: the session and the turn",
            "at the error: session none · .* · idle"
          ],
          [
            "the screen as it was",
            "^end screen$"
          ],
          [
            "the exit, with its code",
            "exit, code 1"
          ]
        ]
      }
    }
  }
}
