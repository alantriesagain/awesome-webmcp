{
  "name": "desktop",
  "private": true,
  "type": "module",
  "description": "The chat as a desktop app: a scriptc backend on light's desktop host, a light page in the system web view.",
  "dependencies": {
    "@bootstrapp/light": "workspace:*",
    "@widecode/agent": "workspace:*",
    "@light/lib": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.5"
  },
  "native": {
    "entry": "src/main.ts",
    "binary": "harness-desktop",
    "web": "web",
    "ffi": "@bootstrapp/light/native/desktop/out/linux-x64/ffi.json",
    "tests": false,
    "selftest": {
      "wait": 120,
      "checks": [
        [
          "page connected",
          "page connected"
        ],
        [
          "claude started",
          "agent started"
        ],
        [
          "session initialised",
          "init session="
        ],
        [
          "turn completed",
          "result success"
        ],
        [
          "page saw the result",
          "page info: saw result"
        ]
      ]
    }
  }
}
